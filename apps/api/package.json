{
  "name": "@sct/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "cross-env NODE_ENV=production node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@sct/audit": "workspace:*",
    "@sct/config": "workspace:*",
    "@sct/database": "workspace:*",
    "@sct/network": "workspace:*",
    "@sct/observability": "workspace:*",
    "@sct/providers": "workspace:*",
    "@sct/solana": "workspace:*",
    "@sct/transactions": "workspace:*",
    "@sct/validation": "workspace:*",
    "@solana/kit": "8.4.0",
    "bullmq": "6.3.10",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sct/testing": "workspace:*",
    "cross-env": "10.1.0",
    "postgres": "3.4.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
