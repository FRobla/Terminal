{
  "name": "@sct/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scripts/migrate": "./scripts/migrate.ts",
    "./scripts/seed": "./scripts/seed.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "uuid": "14.0.2",
    "@sct/network": "workspace:*",
    "@sct/validation": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "@sct/testing": "workspace:*"
  }
}
