# Solana Corporate Terminal — environment template
# Copy to `.env` and fill in local values. Never commit `.env` or real secrets.
# Every variable is validated at startup by packages/config (see OPERATIONS.md §3).

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# local | ci | staging | production
APP_ENV=local
# debug | info | warn | error
LOG_LEVEL=info

# --- Solana ------------------------------------------------------------------
# localnet | devnet | testnet   (mainnet-beta is rejected in the MVP)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional; derived from SOLANA_RPC_URL when omitted
SOLANA_WS_URL=wss://api.devnet.solana.com
# Optional keyed fallback RPC. Treat as a secret if it embeds an API key.
SOLANA_RPC_FALLBACK_URL=
# Required only when SOLANA_CLUSTER=localnet (public clusters use built-in constants)
SOLANA_EXPECTED_GENESIS_HASH=

# Terminal (browser-exposed). Must equal SOLANA_CLUSTER.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Application origins and ports -------------------------------------------
PUBLIC_APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
# Bind address; use 0.0.0.0 only inside containers
API_HOST=127.0.0.1

# --- Database (PostgreSQL) ---------------------------------------------------
# Application role: no DDL, no UPDATE/DELETE on audit_events
DATABASE_URL=postgresql://sct_app:change-me@localhost:5432/solana_terminal
# Migration role: DDL privileges, used only by migration scripts
DATABASE_MIGRATION_URL=postgresql://sct_migrator:change-me@localhost:5432/solana_terminal

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Security ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Reserved; unused in Iteration 02 (local wallet keys are encrypted in the browser). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_TTL_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=1800
# Sign-in requests (challenge + verify) allowed per client per minute (5-1000).
AUTH_RATE_LIMIT_PER_MINUTE=20
# Wallet address that becomes owner of the default organization on first sign-in,
# only while that organization has no owner (SPEC-007 RBAC-AC-04). Public address only.
BOOTSTRAP_OWNER_WALLET_ADDRESS=
# Temporary (until organization management, Iteration 08): system role granted in the
# default organization to any user without a membership (SPEC-007 RBAC-AC-05).
# One of admin, operator, trader, analyst, auditor, viewer. Empty disables it. Rejected in production.
DEFAULT_MEMBER_ROLE=

# --- Observability -----------------------------------------------------------
# Leave empty to disable OpenTelemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- External providers (backend only; never exposed to the browser) ---------
# Required from Iteration 03/04 (free plans require keys). See DATA_SOURCES.md.
JUPITER_API_KEY=
HELIUS_API_KEY=

# --- Tests -------------------------------------------------------------------
# true enables @devnet tests against the real Devnet RPC
RUN_DEVNET_TESTS=false
