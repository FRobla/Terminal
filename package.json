{
  "name": "solana-corporate-terminal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:devnet": "cross-env RUN_DEVNET_TESTS=true vitest run --project devnet",
    "test:e2e": "pnpm --filter @sct/terminal build && playwright test",
    "coverage": "vitest run --project unit --coverage",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "db:generate": "pnpm --filter @sct/database db:generate",
    "db:migrate": "pnpm --filter @sct/database db:migrate",
    "db:seed": "pnpm --filter @sct/database db:seed",
    "check:bundle": "node scripts/check-production-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "tsx": "4.23.15",
    "@sct/testing": "workspace:*",
    "@sct/database": "workspace:*",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "@sct/network": "workspace:*",
    "@sct/providers": "workspace:*",
    "@sct/solana": "workspace:*",
    "@sct/transactions": "workspace:*",
    "@solana/kit": "8.4.0",
    "@next/eslint-plugin-next": "16.3.8"
  }
}
